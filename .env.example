# PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PAYOUT_EMAIL=          # sandbox personal account that receives withdrawals
APP_BASE_URL=http://localhost:8000

# Chair (reasoning model). Any OpenAI-compatible endpoint:
#   Fin-R1 served by vLLM/Ollama, or Groq / Gemini's OpenAI-compatible API.
CHAIR_BASE_URL=
CHAIR_MODEL=
CHAIR_API_KEY=

# Backup reasoning model, used automatically when the main one hits its limit or fails.
# Local example (Ollama): CHAIR2_BASE_URL=http://localhost:11434/v1  CHAIR2_MODEL=qwen3:8b  CHAIR2_API_KEY=ollama
CHAIR2_BASE_URL=
CHAIR2_MODEL=
CHAIR2_API_KEY=

# Optional: how many futures Kronos simulates for the prediction range (more = smoother but slower)
KRONOS_SAMPLES=10
# Optional: path to a clone of github.com/shiyu-coder/Kronos to enable the Kronos forecaster
KRONOS_REPO=
# Optional: require this token (x-token header) on state-changing routes
COIN_TOKEN=
